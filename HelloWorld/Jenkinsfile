pipeline {
    agent any

    environment {
        // --- Project ---
        PROJECT_NAME        = "HelloWorld"
        CAR_FILE            = "HelloWorldCompositeExporter-1.0.0-SNAPSHOT.car"

        // --- Paths ---
        DOCKER_PROJECT_PATH = "/home/svc_account_wso2/SIT_MI_Docker_Project"
        CAPP_DEST_DIR       = "${DOCKER_PROJECT_PATH}/capps"

        // --- Docker ---
        // No registry push needed — image loaded directly into kind
        IMAGE_NAME          = "mi-sit"
        IMAGE_TAG           = "sit${BUILD_NUMBER.padLeft(4, '0')}"
        FULL_IMAGE          = "${IMAGE_NAME}:${IMAGE_TAG}"

        // --- Kind cluster name (from: kubectl get nodes) ---
        KIND_CLUSTER        = "wso2-cluster"

        // --- Kubernetes ---
        K8S_NAMESPACE       = "mi"
        HELM_RELEASE        = "mi"
        HELM_CHART_PATH     = "${DOCKER_PROJECT_PATH}/helm"
        VALUES_FILE         = "${DOCKER_PROJECT_PATH}/values-dev.yaml"
    }

    stages {

        // ─────────────────────────────────────────────
        // 1. Checkout
        // ─────────────────────────────────────────────
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-ssh-key',
                    url: 'git@github.com:pradyuman202-max/mi-cert-deployment.git'
            }
        }

        stage('Verify Repo Files') {
            steps {
                sh '''
                echo "=== Workspace root ==="
                ls -l

                echo "=== HelloWorld subfolder ==="
                ls -l HelloWorld/

                echo "=== Verifying .car file exists ==="
                if [ ! -f "HelloWorld/${CAR_FILE}" ]; then
                    echo "ERROR: ${CAR_FILE} not found in HelloWorld/"
                    exit 1
                fi
                echo "Found: HelloWorld/${CAR_FILE}"
                ls -lh HelloWorld/${CAR_FILE}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 2. Copy .car to Docker build context
        // ─────────────────────────────────────────────
        stage('Copy CApp to Docker Context') {
            steps {
                sh '''
                echo "=== Clearing old .car files from capps/ ==="
                rm -f ${CAPP_DEST_DIR}/*.car

                echo "=== Copying ${CAR_FILE} to Docker context ==="
                mkdir -p ${CAPP_DEST_DIR}
                cp HelloWorld/${CAR_FILE} ${CAPP_DEST_DIR}/

                echo "=== Contents of capps/ ==="
                ls -lh ${CAPP_DEST_DIR}/
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 3. Docker build
        // ─────────────────────────────────────────────
        stage('Docker Build') {
            steps {
                sh '''
                echo "=== Building Docker image: ${FULL_IMAGE} ==="
                cd ${DOCKER_PROJECT_PATH}

                docker build \
                    --no-cache \
                    -t ${FULL_IMAGE} \
                    .

                echo "=== Image built successfully ==="
                docker images | grep ${IMAGE_NAME}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 4. Load image directly into kind cluster
        //    (avoids localhost:5000 registry pull issue)
        // ─────────────────────────────────────────────
        stage('Load Image into Kind') {
            steps {
                sh '''
                echo "=== Loading ${FULL_IMAGE} into kind cluster: ${KIND_CLUSTER} ==="
                kind load docker-image ${FULL_IMAGE} --name ${KIND_CLUSTER}

                echo "=== Verifying image loaded into kind ==="
                docker exec ${KIND_CLUSTER}-control-plane crictl images | grep ${IMAGE_NAME}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 5. Update values-dev.yaml
        //    Tag format: sit0001, sit0002 ... easy rollback
        //    To rollback: change tag to sit0005 → helm upgrade
        // ─────────────────────────────────────────────
        stage('Update values-dev.yaml') {
            steps {
                sh '''
                echo "=== Updating image section in values-dev.yaml ==="

                sed -i "s|repository:.*|repository: ${IMAGE_NAME}|"   ${VALUES_FILE}
                sed -i "s|tag:.*|tag: ${IMAGE_TAG}|"                  ${VALUES_FILE}
                # IfNotPresent — image already loaded into kind, no pull needed
                sed -i "s|pullPolicy:.*|pullPolicy: IfNotPresent|"     ${VALUES_FILE}

                echo "=== Current image section ==="
                grep -A 3 "^image:" ${VALUES_FILE}
                echo ""
                echo "=== To rollback: change tag to previous sit#### and run helm upgrade ==="
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 6. Helm deploy + force pod restart
        // ─────────────────────────────────────────────
        stage('Helm Deploy (Dev)') {
            steps {
                sh '''
                echo "=== Deploying to namespace: ${K8S_NAMESPACE} ==="
                helm upgrade --install ${HELM_RELEASE} ${HELM_CHART_PATH} \
                    -f ${VALUES_FILE} \
                    -n ${K8S_NAMESPACE} \
                    --timeout 3m0s

                echo "=== Forcing pod restart to use new image ==="
                kubectl rollout restart deployment/mi-deployment -n ${K8S_NAMESPACE}

                echo "=== Waiting for rollout ==="
                kubectl rollout status deployment/mi-deployment \
                    -n ${K8S_NAMESPACE} \
                    --timeout=120s

                echo "=== Helm release status ==="
                helm status ${HELM_RELEASE} -n ${K8S_NAMESPACE}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 7. Verify
        // ─────────────────────────────────────────────
        stage('Verify Rollout') {
            steps {
                sh '''
                echo "=== Pod status ==="
                kubectl get pods -n ${K8S_NAMESPACE} -o wide

                echo "=== Image running in pods ==="
                kubectl get pods -n ${K8S_NAMESPACE} \
                    -o jsonpath="{.items[*].spec.containers[*].image}" \
                    | tr " " "\n"
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                echo "=== Waiting 15s for MI to initialize ==="
                sleep 15

                POD=$(kubectl get pods -n ${K8S_NAMESPACE} \
                    -l app=mi \
                    -o jsonpath="{.items[0].metadata.name}")

                echo "=== Checking pod: $POD ==="
                kubectl exec $POD -n ${K8S_NAMESPACE} -- \
                    curl -sf http://localhost:9164/healthz \
                    && echo "Health check PASSED" \
                    || echo "Health endpoint not available — check MI management port"
                '''
            }
        }
    }

    post {
        success {
            echo """
            ╔══════════════════════════════════════════╗
            ║        CApp Deployment SUCCESS           ║
            ╠══════════════════════════════════════════╣
            ║  CApp    : ${CAR_FILE}
            ║  Image   : ${FULL_IMAGE}
            ║  NS      : ${K8S_NAMESPACE}
            ║
            ║  ROLLBACK: set tag to previous sit####
            ║  in values-dev.yaml → helm upgrade
            ╚══════════════════════════════════════════╝
            """
        }
        failure {
            sh '''
            echo "=== FAILURE DIAGNOSTICS ==="
            kubectl get pods -n ${K8S_NAMESPACE} || true
            kubectl describe pods -n ${K8S_NAMESPACE} -l app=mi | tail -40 || true
            '''
        }
        cleanup {
            sh '''
            echo "=== Removing old docker images (keep last 3) ==="
            docker images ${IMAGE_NAME} \
                --format "{{.Tag}}" \
                | grep "^sit" \
                | sort -t t -k2 -n \
                | head -n -3 \
                | xargs -I{} docker rmi ${IMAGE_NAME}:{} || true
            '''
        }
    }
}
