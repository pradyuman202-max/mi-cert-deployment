<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
<!--  ── Project Identity ───────────────────────────────────────────  -->
<groupId>com.example</groupId>
<artifactId>HelloWorld</artifactId>
<version>1.0.0-SNAPSHOT</version>
<packaging>pom</packaging>
<name>HelloWorld</name>
<!--  ── SCM (update with your actual GitHub repo) ──────────────────  -->
<scm>
<connection>scm:git:git@github.com:pradyuman202-max/mi-cert-deployment.git</connection>
<developerConnection>scm:git:git@github.com:pradyuman202-max/mi-cert-deployment.git</developerConnection>
<url>https://github.com/pradyuman202-max/mi-cert-deployment</url>
</scm>
<!--  ── Sub-modules (order matters — configs before exporter) ───────  -->
<modules>
<module>HelloWorldConfigs</module>
<module>HelloWorldCompositeExporter</module>
</modules>
<!--  ── WSO2 Maven Repository ──────────────────────────────────────  -->
<repositories>
<repository>
<id>wso2-nexus</id>
<name>WSO2 Public Repository</name>
<url>https://maven.wso2.org/nexus/content/groups/wso2-public/</url>
<releases>
<enabled>true</enabled>
<updatePolicy>daily</updatePolicy>
</releases>
<snapshots>
<enabled>false</enabled>
</snapshots>
</repository>
<repository>
<id>wso2-releases</id>
<name>WSO2 Releases Repository</name>
<url>https://maven.wso2.org/nexus/content/repositories/releases/</url>
</repository>
</repositories>
<pluginRepositories>
<pluginRepository>
<id>wso2-nexus</id>
<name>WSO2 Public Repository</name>
<url>https://maven.wso2.org/nexus/content/groups/wso2-public/</url>
<releases>
<enabled>true</enabled>
<updatePolicy>daily</updatePolicy>
</releases>
<snapshots>
<enabled>false</enabled>
</snapshots>
</pluginRepository>
</pluginRepositories>
<!--  ── Build ──────────────────────────────────────────────────────  -->
<build>
<plugins>
<plugin>
<groupId>org.apache.maven.plugins</groupId>
<artifactId>maven-release-plugin</artifactId>
<version>2.5.3</version>
<configuration>
<tagNameFormat>v@{project.version}</tagNameFormat>
</configuration>
</plugin>
</plugins>
</build>
</project>
