pipeline {
    agent any

    environment {
        // --- Project ---
        PROJECT_NAME        = "HelloWorld"

        // --- Paths ---
        DOCKER_PROJECT_PATH = "/home/svc_account_wso2/SIT_MI_Docker_Project"
        CAPP_DEST_DIR       = "${DOCKER_PROJECT_PATH}/capps"

        // --- Docker ---
        IMAGE_NAME          = "mi-sit"

        // --- Kind cluster ---
        KIND_CLUSTER        = "wso2-cluster"

        // --- Kubernetes ---
        K8S_NAMESPACE       = "mi"
        HELM_RELEASE        = "mi"
        HELM_CHART_PATH     = "${DOCKER_PROJECT_PATH}/helm"
        VALUES_FILE         = "${DOCKER_PROJECT_PATH}/values-dev.yaml"

        // --- Stable image tracking ---
        // Written after every successful deployment.
        // Read by MI-Rollback pipeline to restore last known good image.
        LAST_STABLE_FILE    = "${DOCKER_PROJECT_PATH}/last-stable.txt"
    }

    stages {

        // ─────────────────────────────────────────────
        // 1. Checkout
        // ─────────────────────────────────────────────
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-ssh-key',
                    url: 'git@github.com:pradyuman202-max/mi-cert-deployment.git'
            }
        }

        stage('Verify Repo Files') {
            steps {
                sh '''
                echo "=== Workspace root ==="
                ls -l

                echo "=== HelloWorld subfolder ==="
                ls -l HelloWorld/

                echo "=== All .car files found in HelloWorld/ ==="
                find HelloWorld -name "*.car" -type f

                echo "=== Currently deployed .car files in capps/ ==="
                ls -lh ${CAPP_DEST_DIR}/ || echo "capps/ is empty or missing"

                echo "=== Current image tag in values-dev.yaml ==="
                grep "tag:" ${VALUES_FILE} || echo "WARNING: could not read tag"

                echo "=== Last stable image ==="
                cat ${LAST_STABLE_FILE} 2>/dev/null || echo "No last-stable.txt found yet"
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 2. CApp Change Check — gatekeeper
        // ─────────────────────────────────────────────
        stage('CApp Change Check') {
            steps {
                script {
                    def carpCheck = sh(
                        script: """
                        chmod +x scripts/capp_check.sh
                        scripts/capp_check.sh HelloWorld ${CAPP_DEST_DIR}
                        """,
                        returnStatus: true
                    )

                    if (carpCheck != 0) {
                        echo "No new or updated CApps detected. All downstream stages will be skipped."
                        currentBuild.description = "Skipped — no CApp changes"
                        env.CAPP_CHANGED = "false"
                    } else {
                        echo "New or updated CApp(s) detected. Proceeding with full deployment."
                        env.CAPP_CHANGED = "true"
                    }
                }
            }
        }

        // ─────────────────────────────────────────────
        // 3. Resolve Image Tag + collision check
        // ─────────────────────────────────────────────
        stage('Resolve Image Tag') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                script {
                    def currentTag = sh(
                        script: "grep 'tag:' ${VALUES_FILE} | sed 's/.*tag: *//' | tr -d ' '",
                        returnStdout: true
                    ).trim()

                    echo "Current tag in values-dev.yaml: ${currentTag}"

                    def currentNum = currentTag.replaceAll(/[^0-9]/, '').toInteger()
                    def nextNum    = currentNum + 1
                    def nextTag    = String.format("sit%04d", nextNum)

                    env.IMAGE_TAG  = nextTag
                    env.FULL_IMAGE = "${env.IMAGE_NAME}:${nextTag}"

                    echo "New image tag: ${env.FULL_IMAGE}"
                    currentBuild.description = "CApp deploy — ${env.FULL_IMAGE}"

                    // Tag collision check
                    def tagExists = sh(
                        script: "docker images ${env.IMAGE_NAME} --format '{{.Tag}}' | grep -x '${nextTag}' || true",
                        returnStdout: true
                    ).trim()

                    if (tagExists) {
                        echo "WARNING: Tag ${env.FULL_IMAGE} exists from previous failed build — removing stale image."
                        sh "docker rmi ${env.FULL_IMAGE} || true"
                    } else {
                        echo "Tag ${env.FULL_IMAGE} is clean — no collision detected."
                    }
                }
            }
        }

        // ─────────────────────────────────────────────
        // 4. Copy CApps to Docker build context
        // ─────────────────────────────────────────────
        stage('Copy CApps to Docker Context') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                sh '''
                echo "=== Clearing old .car files from capps/ ==="
                rm -f ${CAPP_DEST_DIR}/*.car

                mkdir -p ${CAPP_DEST_DIR}

                find HelloWorld -name "*.car" -type f | while read CAR; do
                    echo "  Copying: $CAR"
                    cp "$CAR" ${CAPP_DEST_DIR}/
                done

                echo "=== Contents of capps/ ==="
                ls -lh ${CAPP_DEST_DIR}/
                echo "Total .car files staged: $(ls ${CAPP_DEST_DIR}/*.car | wc -l)"
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 5. Docker Build
        // ─────────────────────────────────────────────
        stage('Docker Build') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                sh '''
                echo "=== Building Docker image: ${FULL_IMAGE} ==="
                ls -lh ${CAPP_DEST_DIR}/

                cd ${DOCKER_PROJECT_PATH}
                docker build \
                    --no-cache \
                    -t ${FULL_IMAGE} \
                    .

                echo "=== Image built successfully ==="
                docker images | grep ${IMAGE_NAME}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 6. Load image into Kind
        // ─────────────────────────────────────────────
        stage('Load Image into Kind') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                sh '''
                echo "=== Loading ${FULL_IMAGE} into kind cluster: ${KIND_CLUSTER} ==="
                kind load docker-image ${FULL_IMAGE} --name ${KIND_CLUSTER}

                echo "=== All mi-sit images in kind ==="
                docker exec ${KIND_CLUSTER}-control-plane crictl images | grep ${IMAGE_NAME}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 7. Update values-dev.yaml
        //    Done AFTER successful build + kind load.
        // ─────────────────────────────────────────────
        stage('Update values-dev.yaml') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                sh '''
                echo "=== Updating image section in values-dev.yaml ==="

                sed -i "s|repository:.*|repository: ${IMAGE_NAME}|"  ${VALUES_FILE}
                sed -i "s|tag:.*|tag: ${IMAGE_TAG}|"                 ${VALUES_FILE}
                sed -i "s|pullPolicy:.*|pullPolicy: IfNotPresent|"   ${VALUES_FILE}

                echo "=== Current image section ==="
                grep -A 3 "^image:" ${VALUES_FILE}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 8. Helm deploy + rollout
        // ─────────────────────────────────────────────
        stage('Helm Deploy') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                sh '''
                echo "=== Deploying to namespace: ${K8S_NAMESPACE} ==="
                helm upgrade --install ${HELM_RELEASE} ${HELM_CHART_PATH} \
                    -f ${VALUES_FILE} \
                    -n ${K8S_NAMESPACE} \
                    --timeout 3m0s

                echo "=== Forcing pod restart to use new image ==="
                kubectl rollout restart deployment/mi-deployment -n ${K8S_NAMESPACE}

                echo "=== Waiting for rollout ==="
                kubectl rollout status deployment/mi-deployment \
                    -n ${K8S_NAMESPACE} \
                    --timeout=120s

                helm status ${HELM_RELEASE} -n ${K8S_NAMESPACE}
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 9. Verify Rollout
        //    kubectl wait fixes race condition.
        // ─────────────────────────────────────────────
        stage('Verify Rollout') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                sh '''
                echo "=== Pod status ==="
                kubectl get pods -n ${K8S_NAMESPACE} -o wide

                echo "=== Image running in pods ==="
                kubectl get pods -n ${K8S_NAMESPACE} \
                    -o jsonpath="{.items[*].spec.containers[*].image}" \
                    | tr " " "\\n"

                echo "=== CApps deployed inside pod ==="
                kubectl wait --for=condition=Ready pod \
                    -l app=mi \
                    -n ${K8S_NAMESPACE} \
                    --timeout=60s

                POD=$(kubectl get pods -n ${K8S_NAMESPACE} \
    -l app=mi \
    --field-selector=status.phase=Running \
    -o jsonpath="{range .items[?(!@.metadata.deletionTimestamp)]}{.metadata.name}{'\\n'}{end}" \
    | head -1)

                echo "Using pod: $POD"
                kubectl exec $POD -n ${K8S_NAMESPACE} -- \
                    ls -lh /home/wso2carbon/wso2mi-4.3.0/repository/deployment/server/carbonapps/
                '''
            }
        }

        // ─────────────────────────────────────────────
        // 10. Record Stable Image
        //
        //     Written ONLY after full successful deploy.
        //     MI-Rollback pipeline reads this file to
        //     restore the last confirmed working image.
        //
        //     Format: TAG|TIMESTAMP|BUILD_NUMBER
        //     Example: sit0024|2026-04-21 18:24:05|build-24
        // ─────────────────────────────────────────────
        stage('Record Stable Image') {
            when { environment name: 'CAPP_CHANGED', value: 'true' }
            steps {
                sh '''
                echo "=== Recording successful deployment as last stable ==="

                TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
                RECORD="${IMAGE_TAG}|${TIMESTAMP}|build-${BUILD_NUMBER}"

                echo "$RECORD" > ${LAST_STABLE_FILE}

                echo "Recorded: $RECORD"
                echo "=== last-stable.txt ==="
                cat ${LAST_STABLE_FILE}
                '''
            }
        }
    }

    post {
        success {
            script {
                if (env.CAPP_CHANGED == 'true') {
                    echo """
╔══════════════════════════════════════════════════════╗
║           CApp Deployment SUCCESS                    ║
╠══════════════════════════════════════════════════════╣
║  Image     : ${env.FULL_IMAGE}
║  Namespace : ${K8S_NAMESPACE}
║  Build     : #${BUILD_NUMBER}
║  Stable    : Recorded in last-stable.txt
╠══════════════════════════════════════════════════════╣
║  ROLLBACK STEPS (manual):                            ║
║  1. Go to Jenkins → MI-Rollback → Build Now          ║
║  OR                                                  ║
║  1. sed -i "s|tag:.*|tag: sit####|" ${VALUES_FILE}
║  2. helm upgrade mi ${HELM_CHART_PATH} \\
║        -f ${VALUES_FILE} -n ${K8S_NAMESPACE}
║  3. kubectl rollout restart deployment/mi-deployment \\
║        -n ${K8S_NAMESPACE}
╚══════════════════════════════════════════════════════╝
                    """
                } else {
                    echo "Pipeline completed — no new or updated CApps detected, all stages skipped cleanly."
                }
            }
        }

        failure {
            sh '''
            echo "=== FAILURE DIAGNOSTICS ==="
            kubectl get pods -n ${K8S_NAMESPACE} || true
            kubectl describe pods -n ${K8S_NAMESPACE} -l app=mi | tail -40 || true
            helm status ${HELM_RELEASE} -n ${K8S_NAMESPACE} || true

            echo "=== Last stable image ==="
            cat ${LAST_STABLE_FILE} || echo "No last-stable.txt found"

            echo "=== Current tag in values-dev.yaml ==="
            grep "tag:" ${VALUES_FILE} || true
            '''

            script {
                // Auto-trigger rollback pipeline
                echo "=== Deployment failed — auto-triggering MI-Rollback pipeline ==="
                build job: 'MI-Rollback',
                      parameters: [
                          string(name: 'TRIGGERED_BY',
                                 value: "${env.JOB_NAME} #${env.BUILD_NUMBER} — auto rollback on failure")
                      ],
                      wait: false
            }
        }

        cleanup {
            sh '''
            echo "=== Pruning old local images (keep last 3) ==="
            docker images ${IMAGE_NAME} \
                --format "{{.Tag}}" \
                | grep "^sit" \
                | sort -t t -k2 -n \
                | head -n -3 \
                | xargs -I{} docker rmi ${IMAGE_NAME}:{} || true
            '''
        }
    }
}

